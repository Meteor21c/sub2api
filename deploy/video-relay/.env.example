# Production deployment uses the GitHub-built, digest-pinned image.
VIDEO_RELAY_IMAGE=ghcr.io/meteor21c/sub2api:video-relay-COMMIT@sha256:DIGEST
# Exactly 32 random bytes encoded as 64 hex characters; do not commit a real key.
VIDEO_RELAY_SECRET=
# Exact source hostnames only, comma-separated. No wildcards, paths or ports.
VIDEO_RELAY_ALLOWED_HOSTS=
VIDEO_RELAY_CONCURRENCY=8
